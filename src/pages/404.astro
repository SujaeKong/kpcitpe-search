---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="페이지를 찾을 수 없음 | kpcitpe-search">
  <main class="mx-auto flex min-h-screen max-w-xl flex-col items-center justify-center px-4 py-12 text-center">
    <p class="text-sm font-semibold text-red-600">404</p>
    <h1 class="mt-2 text-xl font-bold text-gray-900">페이지를 찾을 수 없습니다</h1>
    <p class="mt-2 text-sm text-gray-600">주소가 바뀌었거나 없는 회차일 수 있어요.</p>
    <div class="mt-6 flex gap-2">
      <a href={`${baseUrl}/`} class="rounded bg-indigo-600 px-3 py-1.5 text-sm text-white hover:bg-indigo-700">검색으로</a>
      <a href={`${baseUrl}/rounds/`} class="rounded border border-gray-300 bg-white px-3 py-1.5 text-sm hover:bg-gray-50">회차별 목록</a>
    </div>
  </main>
</BaseLayout>
