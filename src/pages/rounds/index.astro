---
import { Image } from 'astro:assets';
import problemsRaw from '../../../data/problems.json';
import type { Problem, SourceType } from '../../lib/types';
import BaseLayout from '../../layouts/BaseLayout.astro';
import kpcLogo from '../../assets/kpc-logo.png';

const problems = problemsRaw as Problem[];

// (sourceType, round) → 문제 수 + 해설지 매핑 카운트
interface RoundStat {
  sourceType: SourceType;
  round: string;
  roundLabel: string;
  roundOrder: number;
  total: number;
  withExplanation: number;
}

const map = new Map<string, RoundStat>();
for (const p of problems) {
  const key = `${p.sourceType}|${p.round}`;
  let s = map.get(key);
  if (!s) {
    s = {
      sourceType: p.sourceType,
      round: p.round,
      roundLabel: p.roundLabel,
      roundOrder: p.roundOrder,
      total: 0,
      withExplanation: 0,
    };
    map.set(key, s);
  }
  s.total++;
  if (p.explanationFileId) s.withExplanation++;
}

const all = [...map.values()];
const sourceOrder: Record<string, number> = { 기출: 0, 합숙: 1, 모의: 2, 자체: 3 };
all.sort((a, b) => {
  const so = (sourceOrder[a.sourceType] ?? 99) - (sourceOrder[b.sourceType] ?? 99);
  if (so !== 0) return so;
  return b.roundOrder - a.roundOrder; // 같은 출처 안에서는 최신부터
});

// 출처별 그룹
const byType = new Map<SourceType, RoundStat[]>();
for (const r of all) {
  let g = byType.get(r.sourceType);
  if (!g) {
    g = [];
    byType.set(r.sourceType, g);
  }
  g.push(r);
}

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="회차별 브라우징 | kpcitpe-search">
  <main class="mx-auto flex min-h-screen max-w-6xl flex-col px-4 py-6">
    <header class="mb-6 flex items-center gap-3">
      <a href={`${baseUrl}/`} class="shrink-0">
        <Image
          src={kpcLogo}
          alt="KPC 기술사회"
          width={144}
          height={144}
          densities={[1, 2, 3]}
          class="h-12 w-12 rounded-full shadow-sm ring-1 ring-red-100"
        />
      </a>
      <div class="min-w-0">
        <a href={`${baseUrl}/`} class="text-xs text-indigo-600 hover:underline">
          ← 검색으로
        </a>
        <h1 class="text-xl font-bold text-gray-900">회차별 브라우징</h1>
        <p class="mt-0.5 text-sm text-gray-500">
          전체 {all.length}회차 · 총 {problems.length.toLocaleString()}문제
        </p>
      </div>
    </header>

    {[...byType.entries()].map(([type, rounds]) => {
      const totalProblems = rounds.reduce((a, r) => a + r.total, 0);
      const totalExp = rounds.reduce((a, r) => a + r.withExplanation, 0);
      return (
        <section class="mb-8">
          <h2 class="mb-3 text-sm font-semibold text-gray-700">
            <span class="mr-2 inline-block rounded bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-800">
              {type}
            </span>
            {rounds.length}회차 · {totalProblems.toLocaleString()}문제
            {totalExp > 0 && (
              <span class="ml-1 text-xs font-normal text-gray-500">
                · 해설지 {totalExp.toLocaleString()}건
              </span>
            )}
          </h2>
          <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
            {rounds.map((r) => {
              const coverage = r.total > 0 ? Math.round((r.withExplanation / r.total) * 100) : 0;
              return (
                <li>
                  <a
                    href={`${baseUrl}/rounds/${encodeURIComponent(r.sourceType)}/${encodeURIComponent(r.round)}`}
                    class="block rounded border border-gray-200 bg-white p-2.5 text-sm transition-shadow hover:shadow-sm"
                  >
                    <div class="font-semibold text-gray-900">{r.roundLabel}</div>
                    <div class="mt-0.5 flex items-center justify-between text-xs text-gray-500">
                      <span>{r.total}건</span>
                      {r.withExplanation > 0 && (
                        <span class="text-emerald-600">📖 {coverage}%</span>
                      )}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      );
    })}

    <footer class="mt-12 border-t border-gray-200 pt-5 pb-3">
      <div class="flex flex-col items-center gap-1.5 text-xs text-gray-500 sm:flex-row sm:justify-center">
        <span class="inline-flex items-center gap-1.5">
          <span>Powered by</span>
          <Image
            src={kpcLogo}
            alt=""
            width={60}
            height={60}
            densities={[1, 2, 3]}
            class="h-5 w-5 rounded-full"
          />
          <span class="font-semibold text-red-600">KPC 기술사회</span>
        </span>
      </div>
    </footer>
  </main>
</BaseLayout>
